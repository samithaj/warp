#!/usr/bin/env bash
#
# Build WarpOss in release mode and install it to /Applications as a personal,
# locally-built app. NOT part of Warp's distribution pipeline (see script/bundle
# for that, which needs Developer-ID certs, GCP secrets and notarization) — this
# just reuses the normal dev bundling path and copies the result.
#
# Usage:  ./script/install-warposs-local [--debug]
#
# Notes:
#   * /Applications is group-writable by admins, so no sudo is required.
#   * The installed app does not auto-update; re-run this after pulling or
#     changing code.
#   * The Projects x Tasks rail needs FeatureFlag::Projects, which OSS builds do
#     not enable via DOGFOOD_FLAGS. If you want it, keep the local (uncommitted)
#     enable in app/src/bin/oss.rs, then turn on the setting in
#     Settings > Appearance.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

# Cargo is not always on the PATH of non-interactive shells; make the script
# work regardless of how it is invoked.
if ! command -v cargo >/dev/null 2>&1 && [ -x "$HOME/.cargo/bin/cargo" ]; then
  PATH="$HOME/.cargo/bin:$PATH"
  export PATH
fi

PROFILE="release"
RUN_ARGS=(--release --dont-open)
if [[ "${1:-}" == "--debug" ]]; then
  PROFILE="debug"
  RUN_ARGS=(--dont-open)
fi

APP_SRC="target/${PROFILE}/bundle/osx/WarpOss.app"
APP_DST="/Applications/WarpOss.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

echo "==> Building WarpOss (${PROFILE})..."
./script/run "${RUN_ARGS[@]}"

if [[ ! -d "${APP_SRC}" ]]; then
  echo "error: expected bundle at ${APP_SRC} but it does not exist" >&2
  exit 1
fi

# Quit any running copy so we don't replace a bundle that's in use.
# --no-quit: swap the bundle under the running app instead of asking it to
# quit. macOS keeps the process alive on the deleted inode, so the running
# session is untouched and the new build takes effect at the next natural
# relaunch. Verified: the app runs fine for days on a deleted bundle.
if [[ "${*}" == *"--no-quit"* ]]; then
  echo "==> --no-quit: leaving the running app untouched; new build applies on next launch"
else
  osascript -e 'quit app "WarpOss"' >/dev/null 2>&1 || true
fi
sleep 1

echo "==> Installing to ${APP_DST}..."
rm -rf "${APP_DST}"
cp -R "${APP_SRC}" "${APP_DST}"

# Point the warposs:// URL scheme at the installed copy rather than any bundle
# left behind under target/, which disappears on `cargo clean`.
echo "==> Registering URL scheme..."
"${LSREGISTER}" -u "${REPO_ROOT}/target/debug/bundle/osx/WarpOss.app" >/dev/null 2>&1 || true
"${LSREGISTER}" -u "${REPO_ROOT}/target/release/bundle/osx/WarpOss.app" >/dev/null 2>&1 || true
"${LSREGISTER}" -f "${APP_DST}"

codesign --verify "${APP_DST}" && echo "==> Signature OK"
echo "==> Installed $(du -sh "${APP_DST}" | cut -f1) to ${APP_DST}"
echo "    Launch with: open -a WarpOss"
